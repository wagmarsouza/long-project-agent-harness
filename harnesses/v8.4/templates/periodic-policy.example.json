{
  "every": 10,
  "anchor": 0,
  "notes_pattern": "notes/cycle-{cycle:04d}.md",
  "digest_pattern": "reports/digest-{start:04d}-{end:04d}.json",
  "governing_file": "GOVERNING.md",
  "invariant_markers": ["EVIDENCE_FIRST", "NO_IMPLICIT_AUTHORITY"],
  "stale_markers": ["REPLACE_WITH_A_PROJECT_SPECIFIC_STALE_REFERENCE"],
  "mutable_sections": {
    "objectives": {"begin": "<!-- objectives -->", "end": "<!-- /objectives -->"},
    "scenario": {"begin": "<!-- scenario -->", "end": "<!-- /scenario -->"}
  }
}
